{
  "compilerOptions": {
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@qframework/core": ["packages/core/src/index.ts"]
    },
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "rootDir": "."
  },
  "include": ["packages/core/src", "packages/laya/src", "packages/fairygui-babylon/src", "types/LayaAir.d.ts"]
}
