{
  "name": "qframework-fairygui-babylon",
  "version": "0.0.2",
  "description": "QFramework adapter for FairyGUI running on Babylon.js",
  "keywords": [
    "qframework",
    "fairygui",
    "babylonjs",
    "typescript",
    "architecture",
    "mvc",
    "cqrs",
    "event",
    "game-framework"
  ],
  "license": "MIT",
  "author": "QFramework.ts contributors",
  "homepage": "https://github.com/996666925/QFramework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/996666925/QFramework.git"
  },
  "bugs": {
    "url": "https://github.com/996666925/QFramework/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@qframework/core": "workspace:*"
  },
  "scripts": {
    "build": "rslib",
    "dev": "rslib --watch"
  }
}
